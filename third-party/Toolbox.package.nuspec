<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DotNetProjects.DotNetSiemensPLCToolBoxLibrary</id>
    <version>4.4.10</version>
    <authors>DotNetProjects</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/jogibear9988/DotNetSiemensPLCToolBoxLibrary</projectUrl>
    <description>DLL for Accessing S7 PLCs</description>
    <repository type="git" url="https://github.com/dotnetprojects/DotNetSiemensPLCToolBoxLibrary" commit="f0b2c5a98fe3e1b71861cd47403aac02338efc99" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="SharpZipLib" version="1.4.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Microsoft.Win32.Registry" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="SharpZipLib" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="System.Text.Encoding.CodePages" version="8.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="any/net461/libnodave_jfkmod.dll" buildAction="Content" copyToOutput="true" />
      <files include="any/netstandard2.1/libnodave_jfkmod.dll" buildAction="Content" copyToOutput="true" />
      <files include="any/net461/libnodave_jfkmod64.dll" buildAction="Content" copyToOutput="true" />
      <files include="any/netstandard2.1/libnodave_jfkmod64.dll" buildAction="Content" copyToOutput="true" />
    </contentFiles>
  </metadata>
</package>