{
  "name": "step7project",
  "displayName": "Step7Project",
  "description": "%extension.description%",
  "version": "0.1.3",
  "publisher": "step7project",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:**/*.s7p",
    "workspaceContains:**/step7project.json"
  ],
  "bin": {
    "step7project": "./bin/step7project.cjs"
  },
  "scripts": {
    "compile": "tsc -p .",
    "build:backend": "dotnet build backend/Step7Bridge.csproj -c Release -o backend/bin",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "npm run build:backend && npm run compile",
    "test:vscode": "npm run compile && node tools/test-vscode.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.7.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "step7project",
          "title": "%view.explorer%",
          "icon": "media/step7.svg"
        }
      ]
    },
    "views": {
      "step7project": [
        {
          "id": "step7project.controls",
          "name": "%view.controls%",
          "visibility": "visible",
          "initialSize": 3
        },
        {
          "id": "step7project.tree",
          "name": "%view.project%",
          "visibility": "visible",
          "initialSize": 7
        }
      ]
    },
    "commands": [
      {
        "command": "step7project.showControls",
        "title": "%command.showControls%",
        "icon": "$(list-tree)"
      },
      {
        "command": "step7project.open",
        "title": "%command.open%",
        "icon": "$(folder-open)"
      },
      {
        "command": "step7project.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "step7project.check",
        "title": "%command.check%",
        "icon": "$(check)"
      },
      {
        "command": "step7project.apply",
        "title": "%command.apply%",
        "icon": "$(save-all)"
      },
      {
        "command": "step7project.create",
        "title": "%command.create%",
        "icon": "$(new-file)"
      },
      {
        "command": "step7project.delete",
        "title": "%command.delete%"
      },
      {
        "command": "step7project.rename",
        "title": "%command.rename%"
      },
      {
        "command": "step7project.copyPath",
        "title": "%command.copyPath%"
      },
      {
        "command": "step7project.copyRelativePath",
        "title": "%command.copyRelativePath%"
      },
      {
        "command": "step7project.reveal",
        "title": "%command.reveal%"
      },
      {
        "command": "step7project.text",
        "title": "%command.text%"
      },
      {
        "command": "step7project.diff",
        "title": "%command.diff%"
      },
      {
        "command": "step7project.restore",
        "title": "%command.restore%"
      },
      {
        "command": "step7project.symbolFormat",
        "title": "%command.symbolFormat%"
      },
      {
        "command": "step7project.selectProject",
        "title": "%command.selectProject%"
      },
      {
        "command": "step7project.copyLocation",
        "title": "%command.copyPath%"
      },
      {
        "command": "step7project.copyRelativeLocation",
        "title": "%command.copyRelativePath%"
      },
      {
        "command": "step7project.revealLocation",
        "title": "%command.reveal%"
      },
      {
        "command": "step7project.revealLocationInWorkspace",
        "title": "%command.revealLocationInWorkspace%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "step7project.showControls",
          "when": "view == step7project.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "step7project.copyPath",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/"
        },
        {
          "command": "step7project.copyRelativePath",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/"
        },
        {
          "command": "step7project.text",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/"
        },
        {
          "command": "step7project.reveal",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/"
        },
        {
          "command": "step7project.diff",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/"
        },
        {
          "command": "step7project.delete",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/"
        },
        {
          "command": "step7project.rename",
          "when": "view == step7project.tree && viewItem == source"
        },
        {
          "command": "step7project.check",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/",
          "group": "step7"
        },
        {
          "command": "step7project.apply",
          "when": "view == step7project.tree && viewItem =~ /^(file|source)$/",
          "group": "step7"
        },
        {
          "command": "step7project.copyLocation",
          "when": "view == step7project.controls && viewItem =~ /^location\\./",
          "group": "location"
        },
        {
          "command": "step7project.copyRelativeLocation",
          "when": "view == step7project.controls && viewItem =~ /^location\\./",
          "group": "location"
        },
        {
          "command": "step7project.revealLocation",
          "when": "view == step7project.controls && viewItem =~ /^location\\./",
          "group": "location"
        },
        {
          "command": "step7project.revealLocationInWorkspace",
          "when": "view == step7project.controls && viewItem == location.view",
          "group": "location"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "step7project.symbols",
        "displayName": "%editor.symbols%",
        "selector": [
          {
            "filenamePattern": "**/Symbols/*.csv"
          },
          {
            "filenamePattern": "*.symbols.csv"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Step7Project",
      "properties": {
        "step7project.awl.mnemonics": {
          "type": "string",
          "enum": [
            "english",
            "german"
          ],
          "default": "english",
          "description": "%setting.step7project.awl.mnemonics%",
          "enumDescriptions": [
            "%enum.step7project.awl.mnemonics.0%",
            "%enum.step7project.awl.mnemonics.1%"
          ]
        },
        "step7project.backup.mode": {
          "type": "string",
          "enum": [
            "off",
            "everySave",
            "1m",
            "10m",
            "30m",
            "1h"
          ],
          "default": "everySave",
          "description": "%setting.step7project.backup.mode%",
          "enumDescriptions": [
            "%enum.step7project.backup.mode.0%",
            "%enum.step7project.backup.mode.1%",
            "%enum.step7project.backup.mode.2%",
            "%enum.step7project.backup.mode.3%",
            "%enum.step7project.backup.mode.4%",
            "%enum.step7project.backup.mode.5%"
          ]
        },
        "step7project.backup.directory": {
          "type": "string",
          "default": "",
          "description": "%setting.step7project.backup.directory%"
        },
        "step7project.symbols.editor": {
          "type": "string",
          "enum": [
            "table",
            "text",
            "default"
          ],
          "default": "table",
          "description": "%setting.step7project.symbols.editor%",
          "enumDescriptions": [
            "%enum.step7project.symbols.editor.0%",
            "%enum.step7project.symbols.editor.1%",
            "%enum.step7project.symbols.editor.2%"
          ]
        },
        "step7project.symbols.format": {
          "type": "string",
          "enum": [
            "csv",
            "asc"
          ],
          "default": "csv",
          "description": "%setting.step7project.symbols.format%"
        },
        "step7project.backend.path": {
          "type": "string",
          "default": "",
          "description": "%setting.step7project.backend.path%"
        },
        "step7project.projectPath.mode": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "default": "relative",
          "description": "%setting.step7project.projectPath.mode%",
          "enumDescriptions": [
            "%enum.projectPath.relative%",
            "%enum.projectPath.absolute%"
          ]
        }
      }
    },
    "languages": [
      {
        "id": "step7-scl",
        "aliases": [
          "STEP 7 SCL"
        ],
        "extensions": [
          ".scl"
        ]
      },
      {
        "id": "step7-awl",
        "aliases": [
          "STEP 7 AWL/STL"
        ],
        "extensions": [
          ".awl",
          ".stl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "step7-scl",
        "scopeName": "source.step7-scl",
        "path": "./media/scl.tmLanguage.json"
      },
      {
        "language": "step7-awl",
        "scopeName": "source.step7-awl",
        "path": "./media/awl.tmLanguage.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "step7project.tree",
        "contents": "%view.welcome%"
      }
    ]
  },
  "l10n": "./l10n"
}
